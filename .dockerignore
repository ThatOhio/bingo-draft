# Build context is the repo root (see docker-compose.yml). Keep node_modules and build
# outputs out of it: images install and build from the workspace manifests instead.
node_modules
*/node_modules
dist
*/dist
build
*/build

.env
.env.*
!.env.docker.example
!*/.env.example

.git
.gitignore
.vscode
.idea

*.log
npm-debug.log*
coverage
.nyc_output
*.tsbuildinfo
