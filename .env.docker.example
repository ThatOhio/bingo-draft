# Docker Compose environment
# Copy to .env and fill in values, then: docker compose up -d --build

# -------- Compose project identity --------
# Names this stack's containers, network, and built images. Compose reads it from this
# file automatically, so `docker compose up -d --build` does the right thing from this
# directory with no -p flag to remember.
#
# Set it to something distinct per deployment (e.g. draft_qa, draft_prod). Without it
# Compose falls back to the directory name, so two clones in same-named directories
# collide: bringing one up recreates the other's containers and overwrites its images.
#
# `docker compose ls` lists every running project and the config file it came from.
COMPOSE_PROJECT_NAME=draft

# -------- Required --------
# PostgreSQL connection string (create the DB on your dedicated DB server first)
# Example: postgresql://user:password@db-server.example.com:5432/bingo_draft?schema=public
DATABASE_URL=postgresql://user:password@your-db-host:5432/bingo_draft?schema=public

JWT_SECRET=your-secret-key-change-in-production
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Redirect URI for Discord OAuth; must match your Discord app and include /api
# When using the default nginx proxy: https://your-domain.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=https://your-domain.com/api/auth/discord/callback

# -------- Public URL (required for CORS and frontend API/socket calls) --------
# Base URL where users reach the site (no trailing slash)
# Examples: http://localhost  or  https://draft.example.com
SITE_URL=http://localhost

# -------- Optional --------
# Port for the frontend/nginx (default 80)
# Must differ between deployments sharing a host, or the second one fails to bind.
PORT=80
